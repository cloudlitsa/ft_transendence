# Copy this file to .env and fill in real values.
# The .env file itself is gitignored and must never be committed.

POSTGRES_USER=checkin
POSTGRES_PASSWORD=changeme_use_a_strong_password
# Use letters and digits only. Punctuation such as at-signs, colons,
# slashes and hashes will break DATABASE_URL, since the password is
# interpolated into a connection string in docker-compose.yml.
POSTGRES_DB=checkin
JWT_SECRET=change_me_generate_with_openssl_rand 