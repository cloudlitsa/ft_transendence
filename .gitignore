# secrets — never commit
.env
# Vite convention for machine-specific env overrides
.env.local 
.env.*.local

# dependencies
node_modules/

# build output
dist/
build/
# TypeScript incremental-build cache, changes on every compile
*.tsbuildinfo

# logs
*.log
npm-debug.log*
#  in case anyone uses yarn instead of npm
yarn-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
# Windows equivalent of .DS_Store
.vscode/
.idea/
Thumbs.db

# other files to ignore
*.zip
# for tests
coverage/