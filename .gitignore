# secrets — never commit
.env
# Vite convention for machine-specific env overrides
.env.local 
.env.*.local

# dependencies
node_modules/

# build output
dist/
build/
# vite-plugin-pwa dev-mode service worker output (regenerated every run)
dev-dist/
# TypeScript incremental-build cache, changes on every compile
*.tsbuildinfo

# logs
*.log
npm-debug.log*
#  in case anyone uses yarn instead of npm
yarn-debug.log*
yarn-error.log*

# OS / editor junk
.DS_Store
# Windows equivalent of .DS_Store
.vscode/
.idea/
Thumbs.db

# other files to ignore
*.zip
# for tests
coverage/

# SSL certificates - mkcert generates them in the certs/ folder, which is not needed in the repo
certs/

# my personal notes, which are not needed in the repo
notes/
