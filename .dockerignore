# Never copy these into the Docker build context.
# Mirrors .gitignore, but Docker reads this one.

# secrets — never bake into an image
.env
.env.*
!.env.example

# dependencies — let the container install its own
**/node_modules

# build output — built inside the container
**/dist
**/build

# Git metadata
.git
.gitignore

# logs / OS junk / editor junk
**/*.log
**/.DS_Store
**/.vscode
**/.idea

# docs that don't need to be in the image
README.md
PROJECT.md
